#!/bin/zsh

# There are two fors for this command:
#   build_mac help
# and
#   build_mac version
#  
# The script reinvokes if the current architecture is not the desired one.
#
if [[ $# == 1 ]]
then
    if [[ "$1" == "help" ]]
    then
        echo "build_mac version"
        exit 0
     fi
elif [[ $# !=  2 ]]
then
    echo "build_mac version"
    exit 1
fi

VERSION="$1"

#===============================================
# Refuse to package a tree with a stale release identity: a version number that
# still names an already-shipped release, or release notes never rolled over
# after it. The Xcode build phase runs the same script, so a .app exported from
# Xcode has already passed it — this catches the case where an OLD export is
# packaged from a tree that has since moved on.
#===============================================
"$(dirname "$0")/../Tooling/check-release-ready.sh" || exit 1

#===============================================
# Signing settings.
#===============================================
# The notary credential is held in the keychain under the profile named here -
# never in this script. It used to carry an Apple ID and an app-specific
# password inline, which put a live credential into the repository's history;
# that password has since been revoked. The profile is created once with
# xcrun notarytool store-credentials, and the settings file lives outside every
# repository so no Developer ID is baked into the source.
MACSIGN_ENV="${MACSIGN_ENV:-$HOME/.config/macsign.env}"
[[ -f "$MACSIGN_ENV" ]] && source "$MACSIGN_ENV"

#===============================================
# Create the format.
#===============================================
installer_name="GuitarTap_${VERSION}.dmg"
app_name="GuitarTap-${VERSION}/GuitarTap.app"
echo "Createing ${installer_name}"

test -f $installer_name && rm $installer_name

    create-dmg \
        --volname "GuitarTap $VERSION Install" \
        --background "guitar-tap-dmg.png" \
        --window-pos 1 1 \
        --icon "GuitarTap.app" 190 350 \
        --window-size 640 535 \
        --icon-size 110 \
        --icon "Applications" 110 110 \
        --hide-extension "Applications" \
        --app-drop-link 450 360 \
        --format ULFO \
        --hdiutil-verbose \
        --volicon "guitar-tap.icns" \
        $installer_name \
        $app_name
if [ $? -ne 0 ]; then
    echo "Creating ${installer_name} failed"
    exit 1
fi

echo "Done Creating ${installer_name}"

#===============================================
# Notarize the format.
#===============================================
if [[ -z "$NOTARY_PROFILE" ]]; then
    echo "NOTARY_PROFILE is not set - skipping notarisation."
    echo "Done creating ${installer_name}"
    exit 0
fi

echo "Notarizing ${installer_name}"
xcrun notarytool submit $installer_name --wait --keychain-profile "$NOTARY_PROFILE"
if [ $? -ne 0 ]; then
    echo "Notarizing ${installer_name} failed"
    exit 1
fi
echo "Done Notarizing the ${installer_name}"

#===============================================
# Staple the format.
#===============================================
echo "Stapling ${installer_name}"
xcrun stapler staple $installer_name
if [ $? -ne 0 ]; then
    echo "Stapling {installer_name} failed"
    exit 1
fi

echo "Done creating ${installer_name}"

